# Development Dockerfile for Server
FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies (including devDependencies for tsx) and tzdata for timezone support
RUN apk add --no-cache tzdata && npm install --legacy-peer-deps

# Expose port
EXPOSE 4000

# Start dev server with tsx watch mode (works without bun)
CMD ["npx", "tsx", "watch", "server.ts"]
