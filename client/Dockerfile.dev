# Development Dockerfile for Client (Next.js)
FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Expose port
EXPOSE 3000

# Enable polling for file changes (works better with Docker volumes)
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

# Start Next.js in dev mode with fast refresh
CMD ["npm", "run", "dev"]
