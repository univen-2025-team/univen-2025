# Docker Environment Configuration
COMPOSE_PROJECT_NAME=univen-2025

# Database Configuration
MONGODB_URI=mongodb://admin:password123@mongodb:27017/univen2025?authSource=admin
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_INITDB_DATABASE=univen2025

# Redis Configuration
REDIS_URL=redis://redis:6379

# Server Configuration
NODE_ENV=development
SERVER_PORT=5000

# Client Configuration
CUSTOMER_PORT=3000

# Google OAuth (replace with real values)
OAUTH2_CLIENT_ID=placeholder
OAUTH2_CLIENT_SECRET=placeholder

# Python Server
CRONJOB_ENABLED=true
VNSTOCK_SOURCE=TCBS
